# Copy to `.env` for local use (never commit the real .env — it's gitignored).
# On Render, set these in the dashboard instead.

# --- Mode -------------------------------------------------------------------
# false = live (calls Gemini). true / unset-without-key = mock (offline).
MOCK_MODE=false

# --- Gemini (only needed for live mode) -------------------------------------
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REASONING_EFFORT=none   # keep 'none' to avoid truncated code responses

# --- Access gate (recommended for any public deployment) --------------------
# If APP_PASSWORD is set, the whole site requires HTTP Basic Auth.
# Leave APP_PASSWORD empty for open local development.
APP_USERNAME=admin
APP_PASSWORD=

# --- Server (optional) ------------------------------------------------------
# HOST=0.0.0.0     # only used by the built-in dev server, not gunicorn
# PORT=5000
